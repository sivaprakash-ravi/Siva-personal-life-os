# SIVA OS client environment
#
# COPY this file to `.env` and fill in values for your environment.
# `.env` is git-ignored — never commit real endpoints/keys here.

# Production / staging API base URL (no trailing slash).
# Required for production builds: the app refuses to start a production
# build without it, rather than silently falling back to a local server.
#
# Development keeps working without this — it falls back to the local
# LAN dev server in non-production builds.
# EXPO_PUBLIC_API_URL=https://api.example.com
