{
  "expo": {
    "name": "SIVA OS",
    "slug": "siva-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon/siva-os-icon.png",
    "scheme": "sivaos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/app-icon/siva-os-icon.png"
    },
    "android": {
      "package": "com.sivaprakashravi.sivaos",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/branding/app-icon/siva-os-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/app-icon/siva-os-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/branding/splash/siva-os-launch.png",
          "resizeMode": "cover"
        }
      ],
      "./plugins/with-siva-launch-screen",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db644b3d-b3e8-4f9a-a2d8-9b57fe9add51"
      }
    },
    "owner": "siva_03"
  }
}
